<resources>
    <color name="orbit_background">#080C1C</color>
    <style name="OrbitTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/orbit_background</item>
        <item name="android:colorAccent">#A4A0FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/orbit_background</item>
        <item name="android:navigationBarColor">@color/orbit_background</item>
    </style>
    <style name="OrbitBrowserTheme" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
